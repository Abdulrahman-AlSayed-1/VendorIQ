# Project settings
APP_NAME="VendorIQ"
APP_ENV="development"
DEBUG=true
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

# AI Agent & WhatsApp Bot Settings
GEMINI_API_KEY="YOUR_KEY"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_TEMPERATURE=0.2
AI_SESSION_TTL_MINUTES=60
AI_SESSION_MAX_TURNS=20
WHATSAPP_SESSION_NAME="vendoriq_whatsapp.db"
# Set to true during personal testing so the bot ONLY responds to "Message Yourself" and ignores all other contacts
WHATSAPP_SELF_CHAT_ONLY=true
# Optional comma-separated phone numbers allowed to talk to the bot (leave empty if not using whitelist)
WHATSAPP_ALLOWED_PHONES=""

# Security
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL with asyncpg driver)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/vendoriq"

# CORS (JSON list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Stripe Sandbox Settings
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_CURRENCY="usd"
FRONTEND_URL="http://localhost:3000"
STRIPE_SUCCESS_URL="http://localhost:3000/checkout/success"
STRIPE_CANCEL_URL="http://localhost:3000/checkout/cancel"
CHECKOUT_RESERVATION_MINUTES=30
